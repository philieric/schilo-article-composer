    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>Schilo Article Composer</AssemblyTitle>
    <Product>Schilo Article Composer</Product>
