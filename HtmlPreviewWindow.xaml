<ui:FluentWindow x:Class="SchiloArticleComposer.HtmlPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Aperçu HTML" Height="800" Width="1000"
        Icon="Assets/logo.ico"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Aperçu HTML (style schilo.org)" />
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="10" Foreground="#888" TextWrapping="Wrap" />
        <wv2:WebView2 x:Name="PreviewBrowser" />
    </DockPanel>
</ui:FluentWindow>
