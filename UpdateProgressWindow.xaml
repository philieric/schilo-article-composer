<ui:FluentWindow x:Class="SchiloArticleComposer.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Schilo Article Composer" Width="420" SizeToContent="Height"
        Icon="Assets/logo.ico"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="" ShowMaximize="False" ShowMinimize="False" ShowClose="False" />
        <StackPanel Margin="20">
            <TextBlock Text="Schilo Article Composer — mise a jour" FontWeight="Bold" Margin="0,0,0,10" />
            <TextBlock x:Name="StatusText" Text="Telechargement de la mise a jour..." Margin="0,0,0,10" TextWrapping="Wrap" />
            <ProgressBar x:Name="ProgressBarControl" Height="18" Minimum="0" Maximum="100" Value="0" />
        </StackPanel>
    </DockPanel>
</ui:FluentWindow>
