<Window x:Class="SchiloArticleComposer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schilo Article Composer" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- Barre du haut -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="OpenButton" Content="Ouvrir un document Word (.docx)..." Click="OpenButton_Click" />
            <Button x:Name="ExportButton" Content="Exporter XML..." Click="ExportButton_Click" IsEnabled="False" />
            <TextBlock x:Name="FileNameText" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#666" />
            <Button x:Name="AboutButton" Content="A propos" Click="AboutButton_Click"
                    HorizontalAlignment="Right" Margin="0" Padding="10,5" />
        </StackPanel>

        <!-- Barre de statut -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="#666" TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- Detail de la section selectionnee -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" Text="Titre de la section" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBox x:Name="TitleBox" DockPanel.Dock="Top" Margin="0,0,0,10" Padding="6"
                         TextChanged="TitleBox_TextChanged" IsEnabled="False" />

                <TextBlock DockPanel.Dock="Top" Text="Contenu (HTML) — editable" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBox x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                         Padding="6" TextChanged="ContentBox_TextChanged" IsEnabled="False" />
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDD" />

            <!-- Liste des sections H2 detectees -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Sections detectees (titres H2)" FontWeight="Bold" Margin="0,0,0,6" />

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="MoveUpButton" Content="↑ Monter" Click="MoveUpButton_Click" />
                    <Button x:Name="MoveDownButton" Content="↓ Descendre" Click="MoveDownButton_Click" />
                </StackPanel>

                <ListBox x:Name="SectionsList" SelectionChanged="SectionsList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,5" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"
                                          ToolTip="Inclure cette section dans l'export XML" />
                                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="250" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
