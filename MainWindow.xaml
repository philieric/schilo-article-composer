<ui:FluentWindow x:Class="SchiloArticleComposer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:SchiloArticleComposer"
        Title="Schilo Article Composer" Height="820" Width="1180"
        MinHeight="620" MinWidth="900"
        Icon="Assets/logo.ico"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Schilo Article Composer" />

        <DockPanel Margin="10">

        <!-- En-tete : logo + presentation de l'application -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="Assets/logo-256.png" Width="40" Height="40" VerticalAlignment="Center" />
            <StackPanel Orientation="Vertical" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Schilo Article Composer" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="Convertit une etude biblique Word (titres « Titre 1 ») en sections XML pretes pour Schilo Builder."
                           Foreground="#888" FontSize="12" />
            </StackPanel>
        </StackPanel>

        <!-- Navigation : SchiloIA | Article Composer -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="NavSchiloIaButton" Content="SchiloIA" Click="NavSchiloIaButton_Click" />
            <Button x:Name="NavArticleComposerButton" Content="Article Composer" Click="NavArticleComposerButton_Click"
                    IsEnabled="False" />
        </StackPanel>

        <!-- Zone de contenu : bascule entre l'ecran Article Composer et l'ecran SchiloIA -->
        <Grid>
            <Grid x:Name="ArticleComposerPanel">
                <DockPanel>
                    <!-- Barre du haut -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button x:Name="OpenButton" DockPanel.Dock="Left" Content="Ouvrir un document Word (.docx)..." Click="OpenButton_Click" />
                        <Button x:Name="ExportButton" DockPanel.Dock="Left" Content="Exporter XML..." Click="ExportButton_Click" IsEnabled="False" />
                        <Button x:Name="HtmlTagColorButton" DockPanel.Dock="Right" Content="Couleur tag HTML..." Click="HtmlTagColorButton_Click" Margin="0" />
                        <Button x:Name="AboutButton" DockPanel.Dock="Right" Content="A propos" Click="AboutButton_Click" />
                        <Button x:Name="CheckUpdateButton" DockPanel.Dock="Right" Content="Verifier les mises a jour" Click="CheckUpdateButton_Click" />
                        <TextBlock x:Name="FileNameText" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#666" />
                    </DockPanel>

                    <!-- Barre de statut -->
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="#666" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Liste des sections H2 detectees -->
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Sections detectees (titres H2)" FontWeight="Bold" Margin="0,0,0,6" />

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="MoveUpButton" Content="↑ Monter" Click="MoveUpButton_Click" />
                                <Button x:Name="MoveDownButton" Content="↓ Descendre" Click="MoveDownButton_Click" />
                            </StackPanel>

                            <ListBox x:Name="SectionsList" SelectionChanged="SectionsList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,5" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                      ToolTip="Inclure cette section dans l'export XML" />
                                            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="250" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDD" />

                        <!-- Detail de la section selectionnee -->
                        <DockPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Titre de la section" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBox x:Name="TitleBox" DockPanel.Dock="Top" Margin="0,0,0,10" Padding="6"
                                     TextChanged="TitleBox_TextChanged" IsEnabled="False" />

                            <TextBlock DockPanel.Dock="Top" Text="Contenu (HTML) — editable" FontWeight="Bold" Margin="0,0,0,4" />
                            <avalonEdit:TextEditor x:Name="ContentBox" SyntaxHighlighting="HTML"
                                     FontFamily="Consolas" FontSize="13" WordWrap="True" ShowLineNumbers="True"
                                     Background="#1E1E1E" Foreground="#D4D4D4" LineNumbersForeground="#6E7681" Padding="6"
                                     TextChanged="ContentBox_TextChanged" IsEnabled="False" />
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Grid>

            <local:SchiloIaView x:Name="SchiloIaPanel" Visibility="Collapsed" />
        </Grid>
        </DockPanel>
    </DockPanel>
</ui:FluentWindow>
