<ui:FluentWindow x:Class="SchiloArticleComposer.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Schilo Article Composer" Height="170" Width="420"
        Icon="Assets/logo.ico"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="16" DockPanel.Dock="Top">
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBox x:Name="InputBox" Padding="6" KeyDown="InputBox_KeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="Annuler" Click="CancelButton_Click" Margin="0,0,8,0" Padding="10,5" />
                <Button x:Name="OkButton" Content="OK" Click="OkButton_Click" Padding="10,5" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</ui:FluentWindow>
