<ui:FluentWindow x:Class="SchiloArticleComposer.ExportHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Historique des exports" Height="480" Width="720"
        Icon="Assets/logo.ico"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Historique des exports" />

        <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OpenFolderButton" Content="Ouvrir le dossier contenant" Click="OpenFolderButton_Click"
                        Padding="10,5" Margin="0,0,8,0" />
                <Button x:Name="CloseButton" Content="Fermer" Click="CloseButton_Click" Padding="10,5" />
            </StackPanel>

            <ListView x:Name="HistoryListView" Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#3A3A3D">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Date" Width="140" DisplayMemberBinding="{Binding DateDisplay}" />
                        <GridViewColumn Header="Document source" Width="220" DisplayMemberBinding="{Binding SourceFileName}" />
                        <GridViewColumn Header="Fichier exporte" Width="220" DisplayMemberBinding="{Binding ExportedFileName}" />
                        <GridViewColumn Header="Sections" Width="80" DisplayMemberBinding="{Binding SectionCount}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </DockPanel>
</ui:FluentWindow>
